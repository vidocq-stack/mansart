<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.vidocq.mansart</groupId>
        <artifactId>mansart-jakarta-data</artifactId>
        <version>0.4.0-SNAPSHOT</version>
    </parent>

    <artifactId>mansart-data-cdi</artifactId>
    <name>Mansart :: Data :: CDI bootstrap</name>
    <description>CDI 4.1 BuildCompatibleExtension that exposes generated repositories as beans. Implementation in M3.</description>

    <properties>
        <vauban.version>0.4.0-SNAPSHOT</vauban.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.vidocq.mansart</groupId>
            <artifactId>mansart-data-core</artifactId>
        </dependency>
        <!-- Jakarta platform API: provided by the CDI container (vidocq-workspace#17); the Vidocq
             runtime extension brings it under Vidocq. -->
        <dependency>
            <groupId>jakarta.enterprise</groupId>
            <artifactId>jakarta.enterprise.cdi-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.inject</groupId>
            <artifactId>jakarta.inject-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- M7-4: needed at compile time so the BCE @Enhancement filter can call
             ClassInfo.hasAnnotation(Repository.class) without scanning every annotation
             through the Vauban index (which doesn't include JDK / jakarta.data jars). -->
        <dependency>
            <groupId>jakarta.data</groupId>
            <artifactId>jakarta.data-api</artifactId>
        </dependency>
        <!-- MANSART-007 — JTA transaction bridge; OPTIONAL on purpose (requires static in
             module-info): a TX-less deployment keeps working, JtaBridgeActivator probes for
             these APIs before loading any typed class. -->
        <dependency>
            <groupId>jakarta.transaction</groupId>
            <artifactId>jakarta.transaction-api</artifactId>
            <version>${jakarta.transaction.version}</version>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>io.vidocq.mansart</groupId>
            <artifactId>mansart-transactions-jdbc</artifactId>
            <version>${project.version}</version>
            <optional>true</optional>
        </dependency>
        <!-- Supplies the VaubanComponentProvider service type of the generated _VaubanComponents
             (module-info `provides`). API types only, no code runs outside Vauban; inert on a class
             path (Weld, Open Liberty). Its Jakarta CDI dependencies are excluded: the container
             brings the CDI API. -->
        <dependency>
            <groupId>io.vidocq.vauban</groupId>
            <artifactId>vauban-api</artifactId>
            <version>${vauban.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>jakarta.enterprise</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>jakarta.inject</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                Vauban codegen runs as an ANNOTATION PROCESSOR on this module's own bean, the default
                RepositoryRuntime producer: the compile generates an in-module _VaubanComponents that
                instantiates it and invokes its producer method, so Vauban needs no
                `opens io.vidocq.mansart.data.cdi` (mansart#35). The synthetic-bean creators are public
                classes of an exported package, reached without deep reflection. Inert under a
                standard CDI container.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>io.vidocq.vauban</groupId>
                            <artifactId>vauban-processor</artifactId>
                            <version>${vauban.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
                <executions>
                    <execution>
                        <id>default-testCompile</id>
                        <configuration>
                            <proc>none</proc>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
