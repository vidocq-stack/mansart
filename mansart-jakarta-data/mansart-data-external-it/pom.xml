<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.vidocq.mansart</groupId>
        <artifactId>mansart-jakarta-data</artifactId>
        <version>0.2.0-SNAPSHOT</version>
    </parent>

    <artifactId>mansart-data-external-it</artifactId>
    <name>Mansart :: Data :: IT :: External Repository Codegen</name>
    <description>Integration test: applies mansart-data-maven-plugin to generate, ahead of time, the
        implementation of a @Repository that lives in the mansart-data-external-lib dependency jar,
        then exercises CRUD on it via H2 — proving the AOT (no runtime reflection) path.</description>

    <dependencies>
        <dependency>
            <groupId>io.vidocq.mansart</groupId>
            <artifactId>mansart-data-external-lib</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.vidocq.mansart</groupId>
            <artifactId>mansart-data-core</artifactId>
        </dependency>
        <!-- Spec APIs needed to compile the ahead-of-time generated sources. -->
        <dependency>
            <groupId>jakarta.data</groupId>
            <artifactId>jakarta.data-api</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.persistence</groupId>
            <artifactId>jakarta.persistence-api</artifactId>
        </dependency>

        <!-- Runtime: H2 dialect (ServiceLoader) + driver. -->
        <dependency>
            <groupId>io.vidocq.mansart</groupId>
            <artifactId>mansart-data-dialect-h2</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <version>${h2.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>${assertj.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>io.vidocq.mansart</groupId>
                <artifactId>mansart-data-maven-plugin</artifactId>
                <version>${project.version}</version>
                <executions>
                    <execution>
                        <id>generate-external-repositories</id>
                        <goals>
                            <goal>generate-external-repositories</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <targetPackage>it.gen</targetPackage>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
