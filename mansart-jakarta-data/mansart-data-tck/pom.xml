<?xml version="1.0" encoding="UTF-8"?>
<!--
  This module is intentionally OUT of the parent reactor (Model 4.0.0 standalone, no <parent>).
  Reason: ShrinkWrap Maven Resolver 3.3 (transitive of the official Jakarta TCK harness) cannot
  parse Maven Model 4.1.0 POMs. See ../../CLAUDE.md (root) for the full rationale.

  Implementation lands in M6.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.vidocq.mansart</groupId>
    <artifactId>mansart-data-tck</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>Mansart :: Data :: Jakarta Data 1.0 TCK runner</name>
    <description>Arquillian harness for the official Jakarta Data 1.0 TCK. Implementation in M6.</description>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>
</project>
