<?xml version="1.0" encoding="UTF-8"?>
<!--
  This module is intentionally OUT of the parent reactor (Model 4.0.0 standalone, no <parent>).
  Reason: ShrinkWrap Maven Resolver 3.3 (transitive of the official Jakarta TCK harness) cannot
  parse Maven Model 4.1.0 POMs. See ../../CLAUDE.md (root) for the full rationale and the
  official-TCK install procedure in this module's README.md.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.vidocq.mansart</groupId>
    <artifactId>mansart-data-tck</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>Mansart :: Data :: Jakarta Data 1.0 TCK runner</name>
    <description>Arquillian harness for the official Jakarta Data 1.0 TCK.</description>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <jakarta.data.version>1.0.1</jakarta.data.version>
        <jakarta.data.tck.version>1.0.1</jakarta.data.tck.version>
        <jakarta.cdi.version>4.1.0</jakarta.cdi.version>

        <mansart.version>1.0.0-SNAPSHOT</mansart.version>
        <vauban.version>0.1.0-SNAPSHOT</vauban.version>

        <arquillian.version>1.9.1.Final</arquillian.version>
        <shrinkwrap.version>1.2.6</shrinkwrap.version>
        <testng.version>7.10.2</testng.version>
        <h2.version>2.3.232</h2.version>

        <maven.compiler.plugin.version>4.0.0-beta-4</maven.compiler.plugin.version>
        <maven.surefire.plugin.version>3.5.2</maven.surefire.plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.jboss.arquillian</groupId>
                <artifactId>arquillian-bom</artifactId>
                <version>${arquillian.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Mansart implementation under test -->
        <dependency>
            <groupId>io.vidocq.mansart</groupId>
            <artifactId>mansart-data-api</artifactId>
            <version>${mansart.version}</version>
        </dependency>
        <dependency>
            <groupId>io.vidocq.mansart</groupId>
            <artifactId>mansart-data-core</artifactId>
            <version>${mansart.version}</version>
        </dependency>
        <dependency>
            <groupId>io.vidocq.mansart</groupId>
            <artifactId>mansart-data-cdi</artifactId>
            <version>${mansart.version}</version>
        </dependency>
        <dependency>
            <groupId>io.vidocq.mansart</groupId>
            <artifactId>mansart-data-dialect-h2</artifactId>
            <version>${mansart.version}</version>
        </dependency>
        <dependency>
            <groupId>io.vidocq.mansart</groupId>
            <artifactId>mansart-data-processor</artifactId>
            <version>${mansart.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Jakarta Data API + TCK -->
        <dependency>
            <groupId>jakarta.data</groupId>
            <artifactId>jakarta.data-api</artifactId>
            <version>${jakarta.data.version}</version>
        </dependency>
        <!-- CDI API (always resolvable from Central) -->
        <dependency>
            <groupId>jakarta.enterprise</groupId>
            <artifactId>jakarta.enterprise.cdi-api</artifactId>
            <version>${jakarta.cdi.version}</version>
        </dependency>

        <!-- Vauban CDI 4.1 Lite container — the Vidocq-ecosystem CDI runtime under which the
             Mansart BCE wires repositories. -->
        <dependency>
            <groupId>io.vidocq.vauban</groupId>
            <artifactId>vauban-core</artifactId>
            <version>${vauban.version}</version>
        </dependency>

        <!-- Pull in a tiny test entity + repository so the smoke harness has something to inject. -->
        <dependency>
            <groupId>io.vidocq.mansart</groupId>
            <artifactId>mansart-data-tests</artifactId>
            <version>${mansart.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- TestNG suite runner — used by the smoke harness too -->
        <dependency>
            <groupId>org.testng</groupId>
            <artifactId>testng</artifactId>
            <version>${testng.version}</version>
        </dependency>

        <!-- Backing database — H2 in-memory by default -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <version>${h2.version}</version>
        </dependency>

        <!-- Vauban indexer — used by the ported Arquillian connector to scan
             ShrinkWrap deployments at runtime. -->
        <dependency>
            <groupId>io.vidocq.vauban</groupId>
            <artifactId>vauban-indexer</artifactId>
            <version>${vauban.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Arquillian core + TestNG container + ShrinkWrap (always available
             on Central; used by the M6.2 smoke harness). The official TCK suite
             dependencies stay behind the `tck-run` profile below. -->
        <dependency>
            <groupId>org.jboss.arquillian.testng</groupId>
            <artifactId>arquillian-testng-container</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.jboss.shrinkwrap</groupId>
            <artifactId>shrinkwrap-api</artifactId>
            <version>${shrinkwrap.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.jboss.shrinkwrap</groupId>
            <artifactId>shrinkwrap-impl-base</artifactId>
            <version>${shrinkwrap.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <profiles>
        <!--
          Enable with `mvn -Ptck-run test` once the prerequisite artefacts are installed in
          the local M2:
            * jakarta.data:jakarta-data-tck:1.0.1 — see README.md "Install the TCK artefacts".
            * org.jboss.weld.se:weld-se-shaded:5.x — usually on Central.
            * org.jboss.arquillian.container:arquillian-weld-embedded:4.0.x — coordinates
              evolved between Arquillian releases; install the right one for your environment.
        -->
        <profile>
            <id>tck-run</id>
            <dependencies>
                <dependency>
                    <groupId>jakarta.data</groupId>
                    <artifactId>jakarta-data-tck</artifactId>
                    <version>${jakarta.data.tck.version}</version>
                </dependency>
                <dependency>
                    <groupId>org.jboss.weld.se</groupId>
                    <artifactId>weld-se-shaded</artifactId>
                    <version>${weld.version}</version>
                </dependency>
                <dependency>
                    <groupId>org.jboss.arquillian.testng</groupId>
                    <artifactId>arquillian-testng-container</artifactId>
                </dependency>
                <dependency>
                    <groupId>org.jboss.arquillian.container</groupId>
                    <artifactId>arquillian-weld-embedded</artifactId>
                    <version>${arquillian.weld.version}</version>
                </dependency>
            </dependencies>
        </profile>
    </profiles>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven.compiler.plugin.version}</version>
                <configuration>
                    <release>25</release>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven.surefire.plugin.version}</version>
                <configuration>
                    <suiteXmlFiles>
                        <suiteXmlFile>src/test/resources/tck-suite.xml</suiteXmlFile>
                    </suiteXmlFiles>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
