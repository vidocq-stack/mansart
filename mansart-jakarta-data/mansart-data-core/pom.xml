<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.1.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.1.0 https://maven.apache.org/xsd/maven-4.1.0.xsd">
    <modelVersion>4.1.0</modelVersion>

    <parent>
        <groupId>io.vidocq.mansart</groupId>
        <artifactId>mansart-jakarta-data</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>mansart-data-core</artifactId>
    <name>Mansart :: Data :: Core runtime</name>
    <description>RepositoryRuntime, ConnectionScope (ScopedValue), RowMapper. Filled in M3.</description>

    <dependencies>
        <dependency>
            <groupId>io.vidocq.mansart</groupId>
            <artifactId>mansart-data-dialect-spi</artifactId>
        </dependency>
        <!-- M7-29 — jakarta.data-api is the spec consumed by RepositoryRuntime, MansartPage,
             MansartCursoredPage, etc. Brought in compile-direct since mansart-data-api
             (which used to expose it transitively) was retired. -->
        <dependency>
            <groupId>jakarta.data</groupId>
            <artifactId>jakarta.data-api</artifactId>
        </dependency>
        <!-- jakarta.transaction-api will be re-added in M3 when the runtime uses UserTransaction. -->
    </dependencies>
</project>
