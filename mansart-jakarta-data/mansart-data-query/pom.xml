<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.vidocq.mansart</groupId>
        <artifactId>mansart-jakarta-data</artifactId>
        <version>0.3.0-SNAPSHOT</version>
    </parent>

    <artifactId>mansart-data-query</artifactId>
    <name>Mansart :: Data :: Query (JPQL/Criteria API)</name>
    <description>JPQL parser, Criteria API implementation, and query execution for Mansart Data. M5 milestone.</description>

    <dependencies>
        <!-- Mansart Data dependencies -->
        <dependency>
            <groupId>io.vidocq.mansart</groupId>
            <artifactId>mansart-data-core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.vidocq.mansart</groupId>
            <artifactId>mansart-data-dialect-spi</artifactId>
        </dependency>

        <!-- Jakarta Persistence API (required for Query, TypedQuery, CriteriaBuilder, etc.) -->
        <dependency>
            <groupId>jakarta.persistence</groupId>
            <artifactId>jakarta.persistence-api</artifactId>
        </dependency>

        <!-- Jakarta Data API (for integration with RepositoryRuntime) -->
        <dependency>
            <groupId>jakarta.data</groupId>
            <artifactId>jakarta.data-api</artifactId>
        </dependency>

        <!-- Test dependencies -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
