<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.vidocq.mansart</groupId>
        <artifactId>mansart-root</artifactId>
        <version>0.2.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <groupId>io.vidocq.mansart</groupId>
    <artifactId>mansart-jakarta-data</artifactId>
    <version>0.2.0</version>
    <packaging>pom</packaging>

    <name>Mansart :: Jakarta Data 1.0</name>
    <description>Jakarta Data 1.0 implementation for the Vidocq ecosystem.</description>
    <url>https://codeberg.org/Vidocq/mansart</url>

    <scm>
        <connection>scm:git:https://codeberg.org/Vidocq/mansart.git</connection>
        <developerConnection>scm:git:ssh://git@codeberg.org/Vidocq/mansart.git</developerConnection>
        <url>https://codeberg.org/Vidocq/mansart</url>
        <tag>HEAD</tag>
    </scm>

    <developers>
        <developer>
            <name>Yann Blazart</name>
            <email>yann.blazart@gmail.com</email>
        </developer>
        <developer>
            <name>Antoine Sabot-Durand</name>
            <email>antoine@sabot-durand.net</email>
        </developer>
    </developers>

    <!--
        Disjunctive triple license: a recipient may use this software under
        ANY ONE of the three licences below, at their option. EPL-2.0 is the
        anchor (see the LICENSE file); per EPL-2.0 section 1, GPL-2.0-or-later
        is offered as a Secondary License.
        SPDX-License-Identifier: EPL-2.0 OR EUPL-1.2 OR GPL-2.0-or-later
    -->
    <licenses>
        <license>
            <name>EPL-2.0</name>
            <url>https://www.eclipse.org/legal/epl-2.0/</url>
            <distribution>repo</distribution>
        </license>
        <license>
            <name>EUPL-1.2</name>
            <url>https://joinup.ec.europa.eu/collection/eupl/eupl-text-eupl-12</url>
            <distribution>repo</distribution>
        </license>
        <license>
            <name>GPL-2.0-or-later</name>
            <url>https://www.gnu.org/licenses/old-licenses/gpl-2.0.html</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <properties>
        <maven.deploy.skip>false</maven.deploy.skip>
        <jakarta.data.version>1.0.1</jakarta.data.version>
        <jakarta.persistence.version>3.2.0</jakarta.persistence.version>
        <jakarta.cdi.version>4.1.0</jakarta.cdi.version>
        <jakarta.inject.version>2.0.1</jakarta.inject.version>
        <jakarta.transaction.version>2.0.1</jakarta.transaction.version>

        <assertj.version>3.27.0</assertj.version>
        <h2.version>2.3.232</h2.version>
        <postgresql.version>42.7.4</postgresql.version>
        <testcontainers.version>1.20.4</testcontainers.version>
    </properties>

    <modules>
        <module>mansart-data-dialects</module>
        <module>mansart-data-core</module>
        <module>mansart-data-processor</module>
        <module>mansart-data-maven-plugin</module>
        <module>mansart-data-cdi</module>
        <module>mansart-data-tests</module>
        <module>mansart-data-external-lib</module>
        <module>mansart-data-external-it</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>jakarta.data</groupId>
                <artifactId>jakarta.data-api</artifactId>
                <version>${jakarta.data.version}</version>
            </dependency>
            <dependency>
                <groupId>jakarta.persistence</groupId>
                <artifactId>jakarta.persistence-api</artifactId>
                <version>${jakarta.persistence.version}</version>
            </dependency>
            <dependency>
                <groupId>jakarta.enterprise</groupId>
                <artifactId>jakarta.enterprise.cdi-api</artifactId>
                <version>${jakarta.cdi.version}</version>
            </dependency>
            <dependency>
                <groupId>jakarta.inject</groupId>
                <artifactId>jakarta.inject-api</artifactId>
                <version>${jakarta.inject.version}</version>
            </dependency>
            <dependency>
                <groupId>jakarta.transaction</groupId>
                <artifactId>jakarta.transaction-api</artifactId>
                <version>${jakarta.transaction.version}</version>
            </dependency>

            <dependency>
                <groupId>io.vidocq.mansart</groupId>
                <artifactId>mansart-data-dialect-spi</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.mansart</groupId>
                <artifactId>mansart-data-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.mansart</groupId>
                <artifactId>mansart-data-processor</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.mansart</groupId>
                <artifactId>mansart-data-maven-plugin</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.mansart</groupId>
                <artifactId>mansart-data-cdi</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.mansart</groupId>
                <artifactId>mansart-data-dialect-h2</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.mansart</groupId>
                <artifactId>mansart-data-dialect-postgresql</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.version}</version>
            </dependency>
            <dependency>
                <groupId>org.assertj</groupId>
                <artifactId>assertj-core</artifactId>
                <version>${assertj.version}</version>
            </dependency>
            <dependency>
                <groupId>com.h2database</groupId>
                <artifactId>h2</artifactId>
                <version>${h2.version}</version>
            </dependency>
            <dependency>
                <groupId>org.postgresql</groupId>
                <artifactId>postgresql</artifactId>
                <version>${postgresql.version}</version>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <release>25</release>
                        <!-- Keep parameter names in the .class files so APT and the runtime
                             proxy (M7-3 @Query :name resolution) can read them. -->
                        <parameters>true</parameters>
                        <compilerArgs>
                            <arg>-parameters</arg>
                        </compilerArgs>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
