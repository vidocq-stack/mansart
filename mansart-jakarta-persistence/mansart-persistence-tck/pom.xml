<?xml version="1.0" encoding="UTF-8"?>
<!--
  This module is intentionally OUT of the parent reactor (Model 4.0.0 standalone, no <parent>).
  Reason: ShrinkWrap Maven Resolver 3.3 (transitive from the official Jakarta TCK harness) cannot
  parse Maven Model 4.1.0 POMs. Same rationale as mansart-data-tck (see mansart-jakarta-data/mansart-data-tck/README.md).
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.vidocq.mansart</groupId>
    <artifactId>mansart-persistence-tck</artifactId>
    <version>0.3.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>Mansart :: Persistence :: Jakarta Persistence 3.2 TCK runner</name>
    <description>Arquillian harness for the official Jakarta Persistence 3.2 TCK.</description>

    <properties>
        <maven.deploy.skip>true</maven.deploy.skip>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <jakarta.persistence.version>3.2.0</jakarta.persistence.version>
        <jakarta.persistence.tck.version>3.2.1</jakarta.persistence.tck.version>
        <jakarta.cdi.version>4.1.0</jakarta.cdi.version>
        <jakarta.transaction.version>2.0.1</jakarta.transaction.version>

        <mansart.version>0.3.0-SNAPSHOT</mansart.version>
        <vauban.version>0.3.0-SNAPSHOT</vauban.version>

        <arquillian.version>1.9.1.Final</arquillian.version>
        <shrinkwrap.version>1.2.6</shrinkwrap.version>
        <testng.version>7.10.2</testng.version>
        <h2.version>2.3.232</h2.version>
        <postgresql.version>42.7.4</postgresql.version>
        <testcontainers.version>1.20.4</testcontainers.version>

        <maven.compiler.plugin.version>3.13.0</maven.compiler.plugin.version>
        <maven.surefire.plugin.version>3.5.2</maven.surefire.plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.jboss.arquillian</groupId>
                <artifactId>arquillian-bom</artifactId>
                <version>${arquillian.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Mansart Persistence implementation under test -->
        <dependency>
            <groupId>jakarta.persistence</groupId>
            <artifactId>jakarta.persistence-api</artifactId>
            <version>${jakarta.persistence.version}</version>
        </dependency>
        <dependency>
            <groupId>io.vidocq.mansart</groupId>
            <artifactId>mansart-persistence-core</artifactId>
            <version>${mansart.version}</version>
        </dependency>
        <dependency>
            <groupId>io.vidocq.mansart</groupId>
            <artifactId>mansart-persistence-spi</artifactId>
            <version>${mansart.version}</version>
        </dependency>
        <dependency>
            <groupId>io.vidocq.mansart</groupId>
            <artifactId>mansart-data-dialect-spi</artifactId>
            <version>${mansart.version}</version>
        </dependency>
        <dependency>
            <groupId>io.vidocq.mansart</groupId>
            <artifactId>mansart-data-dialect-h2</artifactId>
            <version>${mansart.version}</version>
        </dependency>
        <dependency>
            <groupId>io.vidocq.mansart</groupId>
            <artifactId>mansart-persistence-processor</artifactId>
            <version>${mansart.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>io.vidocq.mansart</groupId>
            <artifactId>mansart-transactions-core</artifactId>
            <version>${mansart.version}</version>
        </dependency>

        <!-- Jakarta Transaction API -->
        <dependency>
            <groupId>jakarta.transaction</groupId>
            <artifactId>jakarta.transaction-api</artifactId>
            <version>${jakarta.transaction.version}</version>
        </dependency>

        <!-- Jakarta CDI API -->
        <dependency>
            <groupId>jakarta.enterprise</groupId>
            <artifactId>jakarta.enterprise.cdi-api</artifactId>
            <version>${jakarta.cdi.version}</version>
        </dependency>

        <!-- Vauban CDI 4.1 Lite container -->
        <dependency>
            <groupId>io.vidocq.vauban</groupId>
            <artifactId>vauban-core</artifactId>
            <version>${vauban.version}</version>
        </dependency>

        <!-- Vauban indexer for Arquillian connector -->
        <dependency>
            <groupId>io.vidocq.vauban</groupId>
            <artifactId>vauban-indexer</artifactId>
            <version>${vauban.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- TestNG suite runner -->
        <dependency>
            <groupId>org.testng</groupId>
            <artifactId>testng</artifactId>
            <version>${testng.version}</version>
        </dependency>

        <!-- Backing database — H2 in-memory by default -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <version>${h2.version}</version>
        </dependency>

        <!-- PostgreSQL backing for the TCK -->
        <dependency>
            <groupId>io.vidocq.mansart</groupId>
            <artifactId>mansart-data-dialect-postgresql</artifactId>
            <version>${mansart.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>${postgresql.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Jakarta Annotation API -->
        <dependency>
            <groupId>jakarta.annotation</groupId>
            <artifactId>jakarta.annotation-api</artifactId>
            <version>3.0.0</version>
            <scope>test</scope>
        </dependency>

        <!-- AssertJ for assertions -->
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>3.25.3</version>
            <scope>test</scope>
        </dependency>

        <!-- Arquillian core + TestNG container + ShrinkWrap -->
        <dependency>
            <groupId>org.jboss.arquillian.testng</groupId>
            <artifactId>arquillian-testng-container</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.jboss.shrinkwrap</groupId>
            <artifactId>shrinkwrap-api</artifactId>
            <version>${shrinkwrap.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.jboss.shrinkwrap</groupId>
            <artifactId>shrinkwrap-impl-base</artifactId>
            <version>${shrinkwrap.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <profiles>
        <!--
          Default profile: runs Mansart smoke tests (tck-suite.xml)
        -->
        <profile>
            <id>default</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <suiteXmlFiles>
                                <suiteXmlFile>src/test/resources/tck-suite.xml</suiteXmlFile>
                            </suiteXmlFiles>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        
        <!--
          Smoke profile: runs Mansart smoke tests with TCK dependencies.
          Enable with `mvn -Ptck-run test` to pull in the official Jakarta Persistence 3.2 TCK suite
          alongside the Mansart smoke harness.
        -->
        <profile>
            <id>tck-run</id>
            <dependencies>
                <dependency>
                    <groupId>jakarta.tck</groupId>
                    <artifactId>persistence-tck-spec-tests</artifactId>
                    <version>${jakarta.persistence.tck.version}</version>
                    <scope>test</scope>
                </dependency>
                <dependency>
                    <groupId>jakarta.tck</groupId>
                    <artifactId>persistence-tck-dist</artifactId>
                    <version>${jakarta.persistence.tck.version}</version>
                    <type>jar</type>
                    <scope>test</scope>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <suiteXmlFiles>
                                <suiteXmlFile>src/test/resources/tck-suite.xml</suiteXmlFile>
                            </suiteXmlFiles>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        
        <!--
          M7-23: Full Jakarta Persistence TCK execution profile.
          Use: mvn -Ptck-full test
          This profile runs the complete TCK suite (400+ tests) against Mansart Persistence.
          Requires the TCK artifacts to be installed in local M2 (M7-22).
          
          Note: The TCK uses the TS (Test Suite) framework from jakarta.tck:common.
          Tests are classes named *Client* that extend PMClientBase.
        -->
        <profile>
            <id>tck-full</id>
            <dependencies>
                <!-- Jakarta Persistence TCK artifacts -->
                <dependency>
                    <groupId>jakarta.tck</groupId>
                    <artifactId>persistence-tck-spec-tests</artifactId>
                    <version>${jakarta.persistence.tck.version}</version>
                    <scope>test</scope>
                </dependency>
                <dependency>
                    <groupId>jakarta.tck</groupId>
                    <artifactId>persistence-tck-dist</artifactId>
                    <version>${jakarta.persistence.tck.version}</version>
                    <type>jar</type>
                    <scope>test</scope>
                </dependency>
                <!-- TS Framework (Test Suite) - required for TCK execution -->
                <dependency>
                    <groupId>jakarta.tck</groupId>
                    <artifactId>common</artifactId>
                    <version>11.0.0-RC6</version>
                    <scope>test</scope>
                </dependency>
                <!-- Servlet API - required by TCK signature tests -->
                <dependency>
                    <groupId>jakarta.servlet</groupId>
                    <artifactId>jakarta.servlet-api</artifactId>
                    <version>6.1.0</version>
                    <scope>test</scope>
                </dependency>
                <!-- JUnit Jupiter Engine - required for TCK test discovery via JUnit 5 -->
                <dependency>
                    <groupId>org.junit.jupiter</groupId>
                    <artifactId>junit-jupiter-engine</artifactId>
                    <version>5.11.4</version>
                    <scope>test</scope>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <version>${maven.surefire.plugin.version}</version>
                        <dependencies>
                            <dependency>
                                <groupId>org.apache.maven.surefire</groupId>
                                <artifactId>surefire-junit-platform</artifactId>
                                <version>${maven.surefire.plugin.version}</version>
                            </dependency>
                        </dependencies>
                        <configuration>
                            <!-- Drop the TestNG suite XML so surefire auto-discovers JUnit 5 tests
                                 from the TCK jars via dependenciesToScan. -->
                            <suiteXmlFiles combine.self="override"/>
                            <dependenciesToScan>
                                <dependency>jakarta.tck:persistence-tck-spec-tests</dependency>
                            </dependenciesToScan>
                            <includes>
                                <include>**/ee/jakarta/tck/persistence/core/*/Client*.class</include>
                                <include>**/ee/jakarta/tck/persistence/core/*/*/Client*.class</include>
                            </includes>
                            <systemPropertyVariables>
                                <jimage.dir>${project.build.directory}/jimage-cache</jimage.dir>
                                <platform.mode>standalone</platform.mode>
                                <persistence.unit.name>JPATCK</persistence.unit.name>
                                <persistence.unit.name.2>JPATCK2</persistence.unit.name.2>
                                <jakarta.persistence.provider>io.vidocq.mansart.persistence.core.bootstrap.MansartPersistenceProvider</jakarta.persistence.provider>
                                <jakarta.persistence.jdbc.driver>org.h2.Driver</jakarta.persistence.jdbc.driver>
                                <jakarta.persistence.jdbc.url>jdbc:h2:mem:testdb;DB_CLOSE_DELAY=-1</jakarta.persistence.jdbc.url>
                                <jakarta.persistence.jdbc.user>sa</jakarta.persistence.jdbc.user>
                                <jakarta.persistence.jdbc.password></jakarta.persistence.jdbc.password>
                                <vehicle>standalone</vehicle>
                                <db.supports.sequence>true</db.supports.sequence>
                                <persistence.second.level.caching.supported>true</persistence.second.level.caching.supported>
                                <tck.schema.action>create</tck.schema.action>
                                <!-- Required by TCK PMClientBase.getPersistenceUnitProperties() -->
                                <jpa.provider.implementation.specific.properties>jakarta.persistence.schema-generation.database.action=create:jakarta.persistence.schema-generation.scripts.action=create:jakarta.persistence.schema-generation.create-database-schemas=true</jpa.provider.implementation.specific.properties>
                            </systemPropertyVariables>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!--
          Switch the TCK harness from H2 to PostgreSQL via Testcontainers.
          Cumulative with `tck-run` (use `mvn -Ptck-run,tck-pg test`). Requires Docker on the host.
          The PG deps are compiled unconditionally above (test scope); this profile only flips
          the system property `mansart.tck.dialect=pg` read by MansartTckArchiveAppender, which
          swaps the deployment's DataSource producer + DialectFactory ServiceLoader registration.
        -->
        <profile>
            <id>tck-pg</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <systemPropertyVariables>
                                <mansart.tck.dialect>pg</mansart.tck.dialect>
                                <tck.schema.action>none</tck.schema.action>
                            </systemPropertyVariables>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!--
          Activate the official Jakarta Persistence 3.2 SignatureTests subset.
          Cumulative with `tck-run` (use `mvn -Ptck-run,tck-sig test`).
        -->
        <profile>
            <id>tck-sig</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <includes combine.children="append">
                                <include>**/standalone/signature/SignatureTests.class</include>
                            </includes>
                            <systemPropertyVariables>
                                <jimage.dir>${project.build.directory}/jimage-cache</jimage.dir>
                                <java.specification.version>21</java.specification.version>
                            </systemPropertyVariables>
                            <argLine>--add-exports java.base/jdk.internal.vm.annotation=ALL-UNNAMED --add-opens java.base/jdk.internal.vm.annotation=ALL-UNNAMED</argLine>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!--
          M7-22: Profile to download/build the official Jakarta Persistence 3.2 TCK.
          The official TCK is not on Maven Central, so we need to build it from source.
          This profile attempts to clone and build the TCK repository, then install it to local M2.
          Requires git and network access to https://github.com/jakartaee/persistence-tck.
          Use: mvn -Ptck-download initialize
        -->
        <profile>
            <id>tck-download</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <version>3.1.0</version>
                        <executions>
                            <execution>
                                <id>download-tck</id>
                                <phase>initialize</phase>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                                <configuration>
                                    <target>
                                        <property name="tck.clonedir" value="${project.build.directory}/tck-source/persistence-tck"/>
                                        <property name="tck.repo.url" value="https://github.com/jakartaee/persistence.git"/>
                                        <property name="tck.tag" value="3.2.1-TCK-RELEASE"/>
                                        <property name="tck.source.dir" value="${tck.clonedir}/tck"/>
                                        
                                        <!-- Clone TCK repository -->
                                        <exec executable="git" failonerror="false">
                                            <arg value="clone"/>
                                            <arg value="--depth"/>
                                            <arg value="1"/>
                                            <arg value="--branch"/>
                                            <arg value="${tck.tag}"/>
                                            <arg value="${tck.repo.url}"/>
                                            <arg value="${tck.clonedir}"/>
                                        </exec>
                                        
                                        <!-- Build TCK -->
                                        <exec executable="mvn" dir="${tck.source.dir}" failonerror="false">
                                            <arg value="-ntp"/>
                                            <arg value="clean"/>
                                            <arg value="install"/>
                                            <arg value="-DskipTests"/>
                                        </exec>
                                        
                                        <echo message="TCK build complete. Artifacts should now be in your local M2."/></target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven.compiler.plugin.version}</version>
                <configuration>
                    <release>25</release>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven.surefire.plugin.version}</version>
                <dependencies>
                    <dependency>
                        <groupId>org.apache.maven.surefire</groupId>
                        <artifactId>surefire-testng</artifactId>
                        <version>${maven.surefire.plugin.version}</version>
                    </dependency>
                </dependencies>
            </plugin>
            <!--
              Note: suiteXmlFiles is intentionally NOT configured here.
              It is defined per-profile:
              - Default (no profile): tck-suite.xml (smoke tests)
              - tck-full: uses dependenciesToScan for TCK jars
              Profiles define their own configuration.
            -->
        </plugins>
    </build>
</project>
