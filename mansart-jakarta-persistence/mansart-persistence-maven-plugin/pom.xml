<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.vidocq.mansart</groupId>
        <artifactId>mansart-jakarta-persistence</artifactId>
        <version>0.3.0-SNAPSHOT</version>
    </parent>

    <artifactId>mansart-persistence-maven-plugin</artifactId>
    <packaging>maven-plugin</packaging>
    <name>Mansart :: Persistence :: Maven Plugin</name>
    <description>Build-time, ahead-of-time generation of EntityMetadata / callback dispatcher /
        static metamodel classes for @Entity classes that live in pre-compiled dependency jars
        (where the APT never ran) — e.g. the official Jakarta Persistence TCK entities.</description>

    <dependencies>
        <!-- Reuses the APT generators via ExternalEntityCodegen / SourceSink. -->
        <dependency>
            <groupId>io.vidocq.mansart</groupId>
            <artifactId>mansart-persistence-processor</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Maven Plugin API (provided by Maven at runtime). -->
        <dependency>
            <groupId>org.apache.maven</groupId>
            <artifactId>maven-plugin-api</artifactId>
            <version>3.9.9</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.maven</groupId>
            <artifactId>maven-core</artifactId>
            <version>3.9.9</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.maven.plugin-tools</groupId>
            <artifactId>maven-plugin-annotations</artifactId>
            <version>3.15.1</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- Filter ONLY the hand-written plugin descriptor, and ONLY @project.version@ — see the
             same pattern in mansart-data-maven-plugin: every ${...} in plugin.xml must stay literal
             so Plexus resolves it at mojo execution time inside the consuming project. -->
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>META-INF/maven/plugin.xml</include>
                </includes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>META-INF/maven/plugin.xml</exclude>
                </excludes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <configuration>
                    <useDefaultDelimiters>false</useDefaultDelimiters>
                    <delimiters>
                        <delimiter>@</delimiter>
                    </delimiters>
                </configuration>
            </plugin>
            <!-- Skip maven-plugin-plugin descriptor generation (JDK 25 class files unsupported).
                 Hand-written plugin.xml lives in src/main/resources/META-INF/maven/. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-plugin-plugin</artifactId>
                <version>3.15.1</version>
                <configuration>
                    <skipErrorNoDescriptorsFound>true</skipErrorNoDescriptorsFound>
                </configuration>
                <executions>
                    <execution>
                        <id>default-descriptor</id>
                        <phase>none</phase>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
