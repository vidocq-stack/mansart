<?xml version="1.0" encoding="UTF-8"?>
<!-- Hand-written plugin descriptor: maven-plugin-plugin does not support JDK 25 class files -->
<plugin>
    <name>Mansart Persistence Maven Plugin</name>
    <description>Ahead-of-time generation of EntityMetadata companions for @Entity classes in dependency jars</description>
    <groupId>io.vidocq.mansart</groupId>
    <artifactId>mansart-persistence-maven-plugin</artifactId>
    <version>@project.version@</version>
    <goalPrefix>mansart-persistence</goalPrefix>
    <isolatedRealm>false</isolatedRealm>
    <inheritedByDefault>true</inheritedByDefault>
    <mojos>
        <mojo>
            <goal>generate-external-entities</goal>
            <description>Scan the project classpath for @Entity classes that have no generated
                EntityMetadata companion and emit metadata / callback dispatcher / static metamodel
                sources ahead of time into the same package as each entity.</description>
            <implementation>io.vidocq.mansart.persistence.maven.GenerateExternalEntitiesMojo</implementation>
            <language>java</language>
            <instantiationStrategy>per-lookup</instantiationStrategy>
            <phase>generate-sources</phase>
            <requiresDependencyResolution>test</requiresDependencyResolution>
            <threadSafe>true</threadSafe>
            <parameters>
                <parameter>
                    <name>project</name>
                    <type>org.apache.maven.project.MavenProject</type>
                    <required>true</required>
                    <editable>false</editable>
                    <description>The Maven project</description>
                </parameter>
                <parameter>
                    <name>generatedSourcesDirectory</name>
                    <type>java.io.File</type>
                    <required>false</required>
                    <editable>true</editable>
                    <description>Directory the generated sources are written to (added as a compile or test-compile source root)</description>
                </parameter>
                <parameter>
                    <name>classpathScope</name>
                    <type>java.lang.String</type>
                    <required>false</required>
                    <editable>true</editable>
                    <description>compile (default) or test — which classpath is scanned and which source root receives the output</description>
                </parameter>
                <parameter>
                    <name>packages</name>
                    <type>java.util.List</type>
                    <required>false</required>
                    <editable>true</editable>
                    <description>Optional package-prefix filters; when empty every package is eligible</description>
                </parameter>
                <parameter>
                    <name>skip</name>
                    <type>boolean</type>
                    <required>false</required>
                    <editable>true</editable>
                    <description>Skip external entity generation</description>
                </parameter>
            </parameters>
            <configuration>
                <project implementation="org.apache.maven.project.MavenProject"
                         default-value="${project}"/>
                <generatedSourcesDirectory implementation="java.io.File"
                         default-value="${project.build.directory}/generated-sources/mansart-persistence">${mansart.persistence.generatedSourcesDirectory}</generatedSourcesDirectory>
                <classpathScope implementation="java.lang.String"
                         default-value="compile">${mansart.persistence.scope}</classpathScope>
                <packages implementation="java.util.List"/>
                <skip implementation="boolean"
                      default-value="false">${mansart.persistence.skip}</skip>
            </configuration>
            <requirements>
                <requirement>
                    <role>org.apache.maven.project.MavenProject</role>
                    <field-name>project</field-name>
                </requirement>
            </requirements>
        </mojo>
    </mojos>
</plugin>
