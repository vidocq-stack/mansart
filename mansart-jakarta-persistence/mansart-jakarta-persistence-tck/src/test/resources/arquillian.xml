<?xml version="1.0" encoding="UTF-8"?>
<arquillian xmlns="http://jboss.org/schema/arquillian"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://jboss.org/schema/arquillian http://jboss.org/schema/arquillian/arquillian_1_0.xsd">

    <container qualifier="arquillian" default="true">
        <configuration>
            <!-- Standalone mode for TCK testing -->
            <property name="deploymentExportPath">${project.build.directory}/arquillian</property>
            <property name="useDeploymentDescriptors">false</property>
        </configuration>
    </container>

    <!-- Enable the extension that provides support for the Jakarta CDI API -->
    <extension qualifier="cdi">
        <property name="deploymentDescriptors">src/main/resources/META-INF/beans.xml</property>
    </extension>

    <!-- Enable the extension that provides support for the Jakarta Persistence API -->
    <extension qualifier="persistence">
        <property name="persistenceXml">src/test/resources/persistence.xml</property>
        <property name="persistenceUnit">JPATCK</property>
    </extension>

    <!-- Enable the extension that provides support for the TestNG test framework -->
    <extension qualifier="testng">
        <property name="suiteXmlFiles">src/test/resources/tck-suite.xml</property>
    </extension>

</arquillian>