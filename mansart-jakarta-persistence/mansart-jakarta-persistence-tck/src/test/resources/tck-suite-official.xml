<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  Jakarta Data 1.0 TCK suite (M6.3) — discovers tests from the
  jakarta.data:jakarta.data-tck:1.0.1 jar via surefire's &lt;dependenciesToScan&gt;.
  Includes the Mansart smoke tests up front so any wiring breakage shows up
  as the first failure before the official suite even runs.
-->
<suite name="mansart-data-tck-1.0-official" verbose="1">

    <test name="mansart-smoke">
        <classes>
            <class name="io.vidocq.mansart.data.tck.MansartCdiBootstrapSmokeTest"/>
            <class name="io.vidocq.mansart.data.tck.MansartArquillianSmokeTest"/>
        </classes>
    </test>

    <test name="jakarta-data-tck-standalone">
        <packages>
            <package name="ee.jakarta.tck.data.standalone.*"/>
        </packages>
    </test>

</suite>