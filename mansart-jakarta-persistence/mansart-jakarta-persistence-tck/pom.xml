<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <artifactId>mansart-jakarta-persistence-tck</artifactId>
    <version>0.3.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>Mansart :: Jakarta Persistence :: TCK Runner</name>
    <description>Standalone TCK harness for the official Jakarta Persistence 3.2 TCK (no Mansart dependencies)</description>

    <properties>
        <maven.deploy.skip>true</maven.deploy.skip>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <jakarta.persistence.version>3.2.0</jakarta.persistence.version>
        <jakarta.persistence.tck.version>3.2.1</jakarta.persistence.tck.version>
        <testng.version>7.10.2</testng.version>
        <shrinkwrap.version>1.2.6</shrinkwrap.version>

        <maven.compiler.plugin.version>3.13.0</maven.compiler.plugin.version>
        <maven.surefire.plugin.version>3.5.2</maven.surefire.plugin.version>
    </properties>

    <dependencies>
        <!-- Jakarta Persistence API -->
        <dependency>
            <groupId>jakarta.persistence</groupId>
            <artifactId>jakarta.persistence-api</artifactId>
            <version>${jakarta.persistence.version}</version>
        </dependency>

        <!-- Persistence TCK -->
        <dependency>
            <groupId>jakarta.tck</groupId>
            <artifactId>persistence-tck-spec-tests</artifactId>
            <version>${jakarta.persistence.tck.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- TestNG suite runner -->
        <dependency>
            <groupId>org.testng</groupId>
            <artifactId>testng</artifactId>
            <version>${testng.version}</version>
        </dependency>

        <!-- Arquillian core + TestNG container + ShrinkWrap -->
        <dependency>
            <groupId>org.jboss.arquillian.testng</groupId>
            <artifactId>arquillian-testng-container</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.jboss.shrinkwrap</groupId>
            <artifactId>shrinkwrap-api</artifactId>
            <version>${shrinkwrap.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.jboss.shrinkwrap</groupId>
            <artifactId>shrinkwrap-impl-base</artifactId>
            <version>${shrinkwrap.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- JUnit 5 + AssertJ for local smoke tests -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.11.4</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>3.27.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <profiles>
        <!--
          Enable with `mvn -Ptck-run test` to pull in the official Jakarta Persistence 3.2 TCK suite
          alongside the Mansart smoke harness. The TCK jar is on Maven Central as
          `jakarta.tck:persistence-tck-spec-tests:3.2.1`
        -->
        <profile>
            <id>tck-run</id>
            <dependencies>
                <!-- TCK uses JUnit 5 + Arquillian JUnit 5 -->
                <dependency>
                    <groupId>org.junit.jupiter</groupId>
                    <artifactId>junit-jupiter</artifactId>
                    <version>5.11.4</version>
                    <scope>test</scope>
                </dependency>
                <dependency>
                    <groupId>org.jboss.arquillian.junit5</groupId>
                    <artifactId>arquillian-junit5-container</artifactId>
                    <scope>test</scope>
                </dependency>
                <!-- Servlet API needed by the signature TCK harness even for standalone tests. -->
                <dependency>
                    <groupId>jakarta.servlet</groupId>
                    <artifactId>jakarta.servlet-api</artifactId>
                    <version>6.1.0</version>
                    <scope>test</scope>
                </dependency>
                <!-- Ant — pulled in by the signature TCK runner (heritage from CTS). -->
                <dependency>
                    <groupId>org.apache.ant</groupId>
                    <artifactId>ant</artifactId>
                    <version>1.10.15</version>
                    <scope>test</scope>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <!-- Drop the TestNG suite XML so surefire auto-discovers JUnit 5 tests
                                 from the TCK jar via dependenciesToScan. The Mansart TestNG
                                 smoke tests still get picked up because surefire detects both
                                 providers when both are on the classpath. -->
                            <suiteXmlFiles combine.self="override"/>
                            <dependenciesToScan>
                                <dependency>jakarta.tck:persistence-tck-spec-tests</dependency>
                            </dependenciesToScan>
                            <includes>
                                <include>**/standalone/entity/EntityTests.class</include>
                            </includes>
                            <systemPropertyVariables>
                                <jimage.dir>${project.build.directory}/jimage-cache</jimage.dir>
                            </systemPropertyVariables>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!--
          M7-26 — Activate the official Jakarta Persistence 3.2 SignatureTests subset.
          Cumulative with `tck-run` (use `mvn -Ptck-run,tck-sig test`).
        -->
        <profile>
            <id>tck-sig</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <includes combine.children="append">
                                <include>**/standalone/signature/SignatureTests.class</include>
                            </includes>
                            <systemPropertyVariables>
                                <jimage.dir>${project.build.directory}/jimage-cache</jimage.dir>
                                <java.specification.version>21</java.specification.version>
                            </systemPropertyVariables>
                            <argLine>--add-exports java.base/jdk.internal.vm.annotation=ALL-UNNAMED --add-opens java.base/jdk.internal.vm.annotation=ALL-UNNAMED</argLine>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!--
          M7-27 — Switch the TCK harness from H2 to PostgreSQL via Testcontainers.
          Cumulative with `tck-run` (use `mvn -Ptck-run,tck-pg test`). Requires Docker on the host.
        -->
        <profile>
            <id>tck-pg</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <systemPropertyVariables>
                                <mansart.tck.dialect>pg</mansart.tck.dialect>
                            </systemPropertyVariables>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven.compiler.plugin.version}</version>
                <configuration>
                    <release>25</release>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven.surefire.plugin.version}</version>
                <configuration>
                    <suiteXmlFiles>
                        <suiteXmlFile>src/test/resources/tck-suite.xml</suiteXmlFile>
                    </suiteXmlFiles>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>