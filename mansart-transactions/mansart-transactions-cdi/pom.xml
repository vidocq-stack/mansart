<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.1.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.1.0 https://maven.apache.org/xsd/maven-4.1.0.xsd">
    <modelVersion>4.1.0</modelVersion>

    <parent>
        <groupId>io.vidocq.mansart</groupId>
        <artifactId>mansart-transactions</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>mansart-transactions-cdi</artifactId>
    <name>Mansart :: Transactions :: CDI bootstrap</name>
    <description>CDI 4.1 bootstrap — @Transactional interceptor (REQUIRED, REQUIRES_NEW, MANDATORY, NEVER, NOT_SUPPORTED, SUPPORTS) + @TransactionScoped scope, plugged via BuildCompatibleExtension + portable Extension.</description>

    <properties>
        <vauban.version>0.1.0-SNAPSHOT</vauban.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.vidocq.mansart</groupId>
            <artifactId>mansart-transactions-core</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.transaction</groupId>
            <artifactId>jakarta.transaction-api</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.enterprise</groupId>
            <artifactId>jakarta.enterprise.cdi-api</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.inject</groupId>
            <artifactId>jakarta.inject-api</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.interceptor</groupId>
            <artifactId>jakarta.interceptor-api</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.annotation</groupId>
            <artifactId>jakarta.annotation-api</artifactId>
        </dependency>

        <!-- ====== Test dependencies ====== -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
            Vauban — CDI 4.1 Lite container natif Vidocq. Utilisé pour valider que l'interceptor
            @Transactional et le contexte @TransactionScoped fonctionnent dans le container ciblé
            par les apps Vidocq. Test scope uniquement.
        -->
        <dependency>
            <groupId>io.vidocq.vauban</groupId>
            <artifactId>vauban-core</artifactId>
            <version>${vauban.version}</version>
            <scope>test</scope>
        </dependency>
        <!--
            vauban-core a un `requires` (runtime) sur io.vidocq.vauban.classloader.spi, mais le
            déclare en <optional> dans son pom (non transitif). On l'ajoute donc explicitement
            pour que le module-path de test résolve la boot layer modulaire de vauban-core.
        -->
        <dependency>
            <groupId>io.vidocq.vauban</groupId>
            <artifactId>vauban-classloader-spi</artifactId>
            <version>${vauban.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.vidocq.vauban</groupId>
            <artifactId>vauban-junit</artifactId>
            <version>${vauban.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                Les sous-classes interceptées générées par vauban (TxService$$Intercepted) vivent
                dans CE module mais référencent io.vidocq.vauban.core.interceptor.InterceptorManager.
                vauban-core n'étant qu'une dépendance de TEST (container CDI cible), on ouvre la
                lecture du module uniquement pour l'exécution des tests via l'option add-reads.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>--add-reads io.vidocq.mansart.transactions.cdi=io.vidocq.vauban.core</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
