<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.1.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.1.0 https://maven.apache.org/xsd/maven-4.1.0.xsd">
    <modelVersion>4.1.0</modelVersion>

    <parent>
        <groupId>io.vidocq.mansart</groupId>
        <artifactId>mansart-transactions</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>mansart-transactions-tests</artifactId>
    <name>Mansart :: Transactions :: Integration tests</name>
    <description>Integration tests cross-module — Vauban + @Transactional + @TransactionScoped + XAResource enrolment. JDBC end-to-end attendra mansart-pool XA-aware (M8).</description>

    <properties>
        <vauban.version>0.1.0-SNAPSHOT</vauban.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.vidocq.mansart</groupId>
            <artifactId>mansart-transactions-core</artifactId>
        </dependency>

        <!-- Test scope : CDI bootstrap + Vauban + JDBC -->
        <dependency>
            <groupId>io.vidocq.mansart</groupId>
            <artifactId>mansart-transactions-cdi</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.transaction</groupId>
            <artifactId>jakarta.transaction-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.enterprise</groupId>
            <artifactId>jakarta.enterprise.cdi-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.inject</groupId>
            <artifactId>jakarta.inject-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.vidocq.vauban</groupId>
            <artifactId>vauban-core</artifactId>
            <version>${vauban.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.vidocq.vauban</groupId>
            <artifactId>vauban-junit</artifactId>
            <version>${vauban.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.vidocq.mansart</groupId>
            <artifactId>mansart-pool-core</artifactId>
            <version>1.0.0-SNAPSHOT</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
