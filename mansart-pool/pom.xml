<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.1.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.1.0 https://maven.apache.org/xsd/maven-4.1.0.xsd">
    <modelVersion>4.1.0</modelVersion>

    <parent>
        <groupId>io.vidocq</groupId>
        <artifactId>vidocq-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath/>
    </parent>

    <groupId>io.vidocq.mansart</groupId>
    <artifactId>mansart-pool</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Mansart :: Pool</name>
    <description>JDBC connection pool, virtual-thread-native, zero-dep — peer of mansart-jakarta-data and mansart-persistence.</description>
    <properties>
        <assertj.version>3.27.0</assertj.version>
        <h2.version>2.3.232</h2.version>
        <hikaricp.version>6.2.1</hikaricp.version>
        <jmh.version>1.37</jmh.version>
        <exec.plugin.version>3.5.0</exec.plugin.version>
        <shade.plugin.version>3.6.0</shade.plugin.version>
    </properties>

    <subprojects>
        <subproject>mansart-pool-api</subproject>
        <subproject>mansart-pool-core</subproject>
        <subproject>mansart-pool-tests</subproject>
        <subproject>mansart-pool-bench</subproject>
    </subprojects>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.vidocq.mansart</groupId>
                <artifactId>mansart-pool-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.mansart</groupId>
                <artifactId>mansart-pool-core</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>org.assertj</groupId>
                <artifactId>assertj-core</artifactId>
                <version>${assertj.version}</version>
            </dependency>
            <dependency>
                <groupId>com.h2database</groupId>
                <artifactId>h2</artifactId>
                <version>${h2.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
