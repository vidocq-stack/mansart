{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "omlx": {
      "models": {
        "Qwen3.8-27B-oQ4e-mtp": {
          "name": "Qwen3.8 27B MTP (local)",
          "limit": {
            "context": 65536,
            "output": 4096
          }
        },
        "Qwen3-Coder-Next-MLX-4bit": {
          "name": "Qwen3 Coder Next 4-bit (implementation)",
          "limit": {
            "context": 65536,
            "output": 4096
          }
        },
        "Qwen3-VL-8B-Instruct-MLX-5bit": {
          "name": "Qwen3 VL 8B (fast review)",
          "limit": {
            "context": 32768,
            "output": 2048
          }
        }
      }
    }
  },
  "model": "omlx/Qwen3.8-27B-oQ4e-mtp",
  "small_model": "omlx/Qwen3.8-27B-oQ4e-mtp",
  "agent": {
    "lead": {
      "description": "Orchestrates one verified, reviewable change at a time",
      "mode": "primary",
      "model": "omlx/Qwen3.8-27B-oQ4e-mtp",
      "temperature": 0.2,
      "steps": 24,
      "prompt": "You are the orchestration agent. Your first action for architecture, implementation, or review work MUST be one task call to the named specialist. Do not pre-read the repository, duplicate the specialist's exploration, or use bulk-context tools. Give the specialist a narrow objective and authoritative file paths. After it returns, inspect only the evidence needed to decide the next stage. Run specialists sequentially. Never commit or rewrite Git state.",
      "permission": {
        "edit": "allow",
        "bash": {
          "*": "allow",
          "git commit*": "deny",
          "git push*": "deny",
          "git reset*": "deny",
          "git clean*": "deny",
          "git restore*": "deny",
          "git checkout*": "deny"
        },
        "task": {
          "*": "deny",
          "architect": "allow",
          "implementer": "allow",
          "reviewer": "allow",
          "plan-corrector": "allow"
        },
        "ctx_*": "deny"
        ,"external_directory": {
          "/Users/yblazart/.m2/repository/**": "allow"
        }
      }
    }
  }
}
