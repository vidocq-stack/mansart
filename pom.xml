<?xml version="1.0" encoding="UTF-8"?>
<!--
    Pom racine "agrégateur" — il NE FAIT PAS office de parent pour les sous-reactors.
    Les trois sous-projets (mansart-pool, mansart-jakarta-data, mansart-transactions) sont
    des reactors Maven INDÉPENDANTS, chacun avec son propre groupId/version/distributionManagement
    et build/deploy lifecycle (chacun parente vidocq-parent directement, jamais ce workspace).
    Ce pom existe uniquement pour :
      * permettre à IntelliJ d'importer le workspace en un seul "Maven project"
      * permettre `mvn -ntp install` à la racine de builder les trois reactors en cascade

    Pattern : Maven 4 <modules> + packaging=pom, sans dependencyManagement ni
    pluginManagement propres (chaque reactor a le sien, calibré à ses besoins).

    Il hérite tout de même de vidocq-parent : ce pom agrégateur est lui-même déployé en
    tête du reactor par `mvn -Psnapshot deploy` (CI), et a donc besoin du
    distributionManagement (central-snapshots) + du profil snapshot fournis par le parent.
    Sans parent, le deploy de ce pom échouait ("repository element was not specified"),
    faisant avorter tout le deploy → aucun artefact mansart publié. L'héritage n'affecte
    QUE ce pom (les sous-reactors ne le parentent pas), donc n'altère pas leurs builds.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.vidocq</groupId>
        <artifactId>vidocq-parent</artifactId>
        <version>0.1.1-SNAPSHOT</version>
        <relativePath/>
    </parent>

    <groupId>io.vidocq.mansart</groupId>
    <artifactId>mansart-workspace</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Mansart :: Workspace</name>
    <description>Aggregator for the three independent Mansart reactors — pool, jakarta-data, transactions.</description>
    <url>https://codeberg.org/Vidocq/mansart</url>

    <scm>
        <connection>scm:git:https://codeberg.org/Vidocq/mansart.git</connection>
        <developerConnection>scm:git:ssh://git@codeberg.org/Vidocq/mansart.git</developerConnection>
        <url>https://codeberg.org/Vidocq/mansart</url>
    </scm>

    <developers>
        <developer>
            <name>Yann Blazart</name>
            <email>yann.blazart@gmail.com</email>
        </developer>
        <developer>
            <name>Antoine Sabot-Durand</name>
            <email>antoine@sabot-durand.net</email>
        </developer>
    </developers>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0</url>
        </license>
    </licenses>

    <modules>
        <module>mansart-pool</module>
        <module>mansart-jakarta-data</module>
        <module>mansart-transactions</module>
    </modules>
</project>
