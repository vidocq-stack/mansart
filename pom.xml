<?xml version="1.0" encoding="UTF-8"?>
<!--
    Pom racine "agrégateur" — il NE FAIT PAS office de parent pour les sous-reactors.
    Les trois sous-projets (mansart-pool, mansart-jakarta-data, mansart-transactions) sont
    des reactors Maven INDÉPENDANTS, chacun avec son propre groupId/version/distributionManagement
    et build/deploy lifecycle. Ce pom existe uniquement pour :
      * permettre à IntelliJ d'importer le workspace en un seul "Maven project"
      * permettre `mvn -ntp install` à la racine de builder les trois reactors en cascade

    Pattern : Maven 4 <subprojects> + packaging=pom, sans dependencyManagement ni
    pluginManagement à ce niveau (chaque reactor a le sien, calibré à ses besoins).
-->
<project xmlns="http://maven.apache.org/POM/4.1.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.1.0 https://maven.apache.org/xsd/maven-4.1.0.xsd">
    <modelVersion>4.1.0</modelVersion>

    <groupId>io.vidocq.mansart</groupId>
    <artifactId>mansart-workspace</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Mansart :: Workspace</name>
    <description>Aggregator for the three independent Mansart reactors — pool, jakarta-data, transactions.</description>

    <subprojects>
        <subproject>mansart-pool</subproject>
        <subproject>mansart-jakarta-data</subproject>
        <subproject>mansart-transactions</subproject>
    </subprojects>
</project>
