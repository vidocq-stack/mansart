<?xml version="1.0" encoding="UTF-8"?>
<!--
    POM racine agrégateur ET parent des trois sous-réactors.
    Les trois sous-projets (mansart-pool, mansart-jakarta-data, mansart-transactions) parentent
    ce POM (qui lui-même parente vidocq-parent), formant ainsi un réacteur Maven UNIFIÉ.
    Cela permet à `mvn versions:set` de versionner les 21 modules en une seule passe,
    condition nécessaire au bon fonctionnement du CI de release.

    Ce POM est déployé sur Maven Central (maven.deploy.skip=false) : packaging=pom, donc
    seul le .pom est publié (pas de jar). C'est OBLIGATOIRE car il est le parent de
    mansart-pool / mansart-jakarta-data / mansart-transactions — un consommateur externe
    (CI vidocq résolvant mansart depuis central-snapshots, hors reactor local) a besoin de
    toute la chaîne de parents pour lire le descripteur d'un artefact enfant. L'exclure
    cassait la résolution (mansart-root:pom absent → mansart-pool-api irrésoluble).

    Pattern : Maven 4 <modules> + packaging=pom, sans dependencyManagement ni
    pluginManagement propres (chaque sous-réacteur a le sien, calibré à ses besoins).
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.vidocq</groupId>
        <artifactId>vidocq-parent</artifactId>
        <version>0.1.1-SNAPSHOT</version>
        <relativePath/>
    </parent>

    <groupId>io.vidocq.mansart</groupId>
    <artifactId>mansart-root</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Mansart :: Workspace</name>
    <description>Aggregator for the three independent Mansart reactors — pool, jakarta-data, transactions.</description>
    <url>https://codeberg.org/Vidocq/mansart</url>

    <scm>
        <connection>scm:git:https://codeberg.org/Vidocq/mansart.git</connection>
        <developerConnection>scm:git:ssh://git@codeberg.org/Vidocq/mansart.git</developerConnection>
        <url>https://codeberg.org/Vidocq/mansart</url>
    </scm>

    <developers>
        <developer>
            <name>Yann Blazart</name>
            <email>yann.blazart@gmail.com</email>
        </developer>
        <developer>
            <name>Antoine Sabot-Durand</name>
            <email>antoine@sabot-durand.net</email>
        </developer>
    </developers>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0</url>
        </license>
    </licenses>

    <properties>
        <!-- Parent pom (packaging=pom): deploy the .pom so external consumers can resolve
             the parent chain of mansart-pool/-jakarta-data/-transactions from central-snapshots. -->
        <maven.deploy.skip>false</maven.deploy.skip>
    </properties>

    <modules>
        <module>mansart-pool</module>
        <module>mansart-jakarta-data</module>
        <module>mansart-transactions</module>
    </modules>
</project>
