<?xml version='1.0' encoding='utf-8'?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.vidocq</groupId>
        <artifactId>vidocq-parent</artifactId>
        <version>0.4.0-RC1</version>
        <relativePath />
    </parent>

    <groupId>io.vidocq.mansart</groupId>
    <artifactId>mansart-root</artifactId>
    <version>0.4.0-RC1</version>
    <packaging>pom</packaging>

    <name>Mansart Root</name>
    <description>Jakarta Data 1.0, Jakarta Transactions 2.0 and a virtual-thread-native JDBC pool for the Vidocq ecosystem.</description>
    <url>https://codefloe.com/Vidocq/mansart</url>

    <scm>
        <connection>scm:git:https://codefloe.com/Vidocq/mansart.git</connection>
        <developerConnection>scm:git:ssh://git@codefloe.com/Vidocq/mansart.git</developerConnection>
        <url>https://codefloe.com/Vidocq/mansart</url>
        <tag>HEAD</tag>
    </scm>

    <developers>
        <developer>
            <name>Yann Blazart</name>
            <email>yann.blazart@gmail.com</email>
        </developer>
        <developer>
            <name>Antoine Sabot-Durand</name>
            <email>antoine@sabot-durand.net</email>
        </developer>
    </developers>

    
    <licenses>
        <license>
            <name>EPL-2.0</name>
            <url>https://www.eclipse.org/legal/epl-2.0/</url>
            <distribution>repo</distribution>
        </license>
        <license>
            <name>EUPL-1.2</name>
            <url>https://joinup.ec.europa.eu/collection/eupl/eupl-text-eupl-12</url>
            <distribution>repo</distribution>
        </license>
        <license>
            <name>GPL-2.0-or-later</name>
            <url>https://www.gnu.org/licenses/old-licenses/gpl-2.0.html</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <modules>
        <module>mansart-pool</module>
        <module>mansart-transactions</module>
        <module>mansart-jakarta-data</module>
    </modules>

    <properties>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>

        
        <sonar.coverage.jacoco.xmlReportPaths>${maven.multiModuleProjectDirectory}/mansart-coverage/target/site/jacoco-aggregate/jacoco.xml</sonar.coverage.jacoco.xmlReportPaths>

        
        <ci.tck.command>mvn -B -ntp -f mansart-jakarta-data/mansart-data-tck/pom.xml -Ptck-run,tck-sig test -DfailIfNoTests=false -Dmansart.version="$(mvn -B -ntp -q -N help:evaluate -Dexpression=project.version -DforceStdout)"</ci.tck.command>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.assertj</groupId>
                <artifactId>assertj-core</artifactId>
                <version>3.27.0</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <profiles>
        
        <profile>
            <id>quality</id>
            <modules>
                <module>mansart-coverage</module>
            </modules>
        </profile>
    </profiles>
</project>